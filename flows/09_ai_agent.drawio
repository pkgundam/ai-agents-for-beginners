<mxfile host="app.diagrams.net"><diagram id="agent" name="ai_agent"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="AI Agent" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="-40" width="200" height="30" as="geometry"/></mxCell><mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="365" y="10" width="70" height="70" as="geometry"/></mxCell><mxCell id="mem" value="Long-term memory&lt;br&gt;&lt;br&gt;facts: home_city = Hyderabad&lt;br&gt;routines: cricket_booking.md" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="220" height="100" as="geometry"/></mxCell><mxCell id="build" value="Build system prompt: role + AUTONOMY + the 8 steps + memory" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="140" height="80" as="geometry"/></mxCell><mxCell id="userq" value="user sends a goal (or &quot;Do my cricket booking&quot;)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="330" y="220" width="140" height="60" as="geometry"/></mxCell><mxCell id="quit" value="is it quit?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="330" y="320" width="140" height="80" as="geometry"/></mxCell><mxCell id="summ" value="Summarize the chat" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="330" width="140" height="60" as="geometry"/></mxCell><mxCell id="store" value="Store chat summary" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="750" y="330" width="140" height="60" as="geometry"/></mxCell><mxCell id="end" value="End" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="935" y="325" width="70" height="70" as="geometry"/></mxCell><mxCell id="addq" value="Add the goal to conv history" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="330" y="450" width="140" height="60" as="geometry"/></mxCell><mxCell id="invoke" value="invoke LLM with conv history + tools" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="330" y="550" width="140" height="60" as="geometry"/></mxCell><mxCell id="need" value="does the next step need a tool?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="320" y="650" width="160" height="100" as="geometry"/></mxCell><mxCell id="asks" value="LLM thinks: one line (what and why)&lt;br&gt;+ asks for a tool" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="660" width="160" height="80" as="geometry"/></mxCell><mxCell id="run" value="Our code runs the tool" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="770" width="160" height="60" as="geometry"/></mxCell><mxCell id="hist" value="Add tool request + tool result to conv history (kept now)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="860" width="160" height="70" as="geometry"/></mxCell><mxCell id="tools" value="Tools the LLM can use (llm_tools)&lt;br&gt;&lt;br&gt;From 04-06:&lt;br&gt;get_current_datetime&lt;br&gt;get_weather&lt;br&gt;get_stock_price&lt;br&gt;get_top_news&lt;br&gt;remember&lt;br&gt;&lt;br&gt;From 08 (cricket):&lt;br&gt;get_available_cities&lt;br&gt;get_weather_for_city_and_date&lt;br&gt;get_all_slots&lt;br&gt;is_slot_available&lt;br&gt;book_slot&lt;br&gt;draft_invite_message&lt;br&gt;send_email" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="500" y="990" width="260" height="255" as="geometry"/></mxCell><mxCell id="answer" value="Goal done, or stuck: LLM answers the user" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="330" y="800" width="140" height="70" as="geometry"/></mxCell><mxCell id="addans" value="Add LLM answer to conv history" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="330" y="910" width="140" height="60" as="geometry"/></mxCell><mxCell id="hdr" value="AUTONOMY + the 8 steps, in the system prompt" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1080" y="40" width="240" height="50" as="geometry"/></mxCell><mxCell id="auto" value="AUTONOMY&lt;br&gt;&lt;br&gt;Work through the steps on your own.&lt;br&gt;After each tool result, decide the next step.&lt;br&gt;Never ask for what you already know.&lt;br&gt;Come back only when done or stuck.&lt;br&gt;One short line before every tool call." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1340" y="10" width="260" height="150" as="geometry"/></mxCell><mxCell id="s1" value="Step 1: Which city?&lt;br&gt;get_available_cities&lt;br&gt;(no city named: home city from memory)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1100" y="120" width="200" height="70" as="geometry"/></mxCell><mxCell id="d1" value="do we know a city with a ground?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1100" y="220" width="200" height="90" as="geometry"/></mxCell><mxCell id="n1" value="Ask which city, stop (guard rail)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1380" y="235" width="180" height="60" as="geometry"/></mxCell><mxCell id="s2" value="Step 2: Saturday or Sunday?&lt;br&gt;get_current_datetime" style="rounded=0;